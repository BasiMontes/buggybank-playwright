# ------------------------------------------------------------------
# Plantilla de variables de entorno.
# 1. Copiá este archivo:  cp .env.example .env
# 2. Completá los valores con las credenciales de TU sandbox.
# 3. NUNCA subas el .env a GitHub (ya está en .gitignore).
# ------------------------------------------------------------------

# URL base de la aplicación. Normalmente no hace falta cambiarla.
BB_BASE_URL=https://buggybank-seven.vercel.app

# Credenciales del usuario temporal que te da "Crear usuario temporal".
# El sandbox dura 24 horas: cuando vence, creá otro y actualizá estos valores.
BB_EMAIL=
BB_PASSWORD=
